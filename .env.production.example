APP_NAME=VokaTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://vocatrack.nadirlabs.net

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Log harian dengan rotasi otomatis (simpan 14 hari) agar berkas log tidak membengkak
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Error monitoring (Sentry). Buat project Laravel di sentry.io lalu salin DSN-nya.
# Hanya ID pengguna, role & school_id yang dikirim — tanpa nama/email/NIS.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false

# Cadangan database otomatis (php artisan vokatrack:backup, terjadwal setiap hari)
# Off-site S3-compatible (Cloudflare R2 / Backblaze B2 / IDCloudHost OSS / AWS S3)
BACKUP_OFFSITE_DISK=backup_s3
BACKUP_OFFSITE_PATH=vokatrack/database
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_SCHEDULE_TIME=02:00
BACKUP_LOCAL_KEEP_DAYS=7
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# Heartbeat cron (Healthchecks.io / BetterStack). URL + "/fail" dipanggil saat gagal.
HEARTBEAT_EVALUATE_ABSENCE_URL=
HEARTBEAT_EVALUATE_SUBSCRIPTIONS_URL=
HEARTBEAT_BACKUP_URL=

# Database Configuration (MySQL / MariaDB on aaPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vocatrack_prod
DB_USERNAME=vocatrack_user
DB_PASSWORD=GantiDenganPasswordDatabaseAman

# Session & Cache — Siap Skala Massal (Gunakan 'redis' untuk rilis produksi)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Konfigurasi Redis (P1-2)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=vokatrack-production-

# WhatsApp Gateway Multi-Channel (P0-2)
WHATSAPP_GATEWAY_PROVIDER=fonnte
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_GATEWAY_URL=https://api.fonnte.com/send
WHATSAPP_GATEWAY_ENABLED=true

# Email / SMTP Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@nadirlabs.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
